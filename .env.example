# ═══════════════════════════════════════════════════════════════════════════════
# JapaGuru AI — Unified Travel Intelligence Platform
# Copy this to .env and fill in your keys.
# All keys go HERE only — never committed to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# Database file path (auto-created on first run)
DB_PATH=./data/jagaguru.db

# ── AI PROVIDERS ──────────────────────────────────────────────────────────────
# Leave blank to disable a provider. At least ONE must be set.

# Anthropic (Claude Sonnet) — console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o) — platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# OpenRouter — openrouter.ai/keys (FREE: DeepSeek, Qwen, Llama, Gemma, Mistral)
OPENROUTER_API_KEY=sk-or-v1-...

# Groq (ultra-fast free tier) — console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google Gemini — aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=AIza...

# Together AI — api.together.ai/settings/api-keys (free $1 credit)
TOGETHER_API_KEY=...

# DeepSeek — platform.deepseek.com (very cheap)
DEEPSEEK_API_KEY=sk-...

# HuggingFace — huggingface.co/settings/tokens (free)
HUGGINGFACE_API_KEY=hf_...

# Ollama (local, offline, free) — ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# ── TRAVEL AFFILIATE (Impact.com) ─────────────────────────────────────────────
# Sign up at app.impact.com — your affiliate IDs for each travel partner.
# These are used to generate tracked links when the AI recommends bookings.

# Booking.com affiliate (Impact) — the most important one for hotels
BOOKING_COM_AFFILIATE_ID=your_impact_affiliate_id

# Skyscanner flights (Impact or RapidAPI)
SKYSCANNER_AFFILIATE_ID=your_skyscanner_id

# RentalCars.com (Impact) — car rentals
RENTALCARS_AFFILIATE_ID=your_rentalcars_id

# Viator (activities & tours, part of TripAdvisor)
VIATOR_API_KEY=your_viator_key
VIATOR_AFFILIATE_ID=your_viator_affiliate_id

# Hostelworld (budget accommodation)
HOSTELWORLD_AFFILIATE_ID=your_hostelworld_id

# GetYourGuide (tours & activities)
GETYOURGUIDE_PARTNER_ID=your_gyg_partner_id

# ── AMADEUS TRAVEL API (free tier — flights + hotels search) ──────────────────
# Register free at developers.amadeus.com — gives real flight prices
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENV=test
# Change to: AMADEUS_ENV=production when going live

# ── PAYMENTS ──────────────────────────────────────────────────────────────────
# Enable whichever payment providers you want to accept.

# Paystack (best for Nigeria) — dashboard.paystack.com/settings/developers
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# Flutterwave (pan-African) — dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_PROD_...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_PROD_...

# Stripe (international) — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OPay (Nigeria digital wallet) — merchant.opayweb.com
OPAY_MERCHANT_ID=...
OPAY_SECRET_KEY=...
OPAY_PUBLIC_KEY=...

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=JapaGuru AI
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ── APP SETTINGS ──────────────────────────────────────────────────────────────
APP_NAME=JapaGuru AI
APP_URL=http://localhost:4000
SUPPORT_EMAIL=support@yourdomain.com

# ── SOCIAL DIRECT POSTING (optional — admin Social Posts tab) ────────────────
# X (Twitter) API v2 — keys from developer.x.com (project app, read+write).
# Enables real auto-posting of scheduled social posts to X.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Telegram Bot API — create a bot with @BotFather, add it to your channel
# as admin, then set the chat id (channel @handle or numeric -100… id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bluesky (AT Protocol) — app password from Bluesky → Settings → App passwords
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
# Discord channel webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# Webhook fallbacks (Zapier/Make/n8n or platform-specific incoming webhooks).
# Used for platforms without a direct integration above.
SOCIAL_TWITTER_WEBHOOK=
SOCIAL_FACEBOOK_WEBHOOK=
SOCIAL_LINKEDIN_WEBHOOK=
SOCIAL_TELEGRAM_WEBHOOK=
SOCIAL_SLACK_WEBHOOK=
# How often the social scheduler scans for due posts (seconds, default 60)
SOCIAL_SCAN_INTERVAL=60
