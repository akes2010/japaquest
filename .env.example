# ═══════════════════════════════════════════════════════════════════════════════
# JapaQuest — Your Journey. Our Intelligence.
# Copy this to .env and fill in your keys.
# All keys go HERE only — never committed to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# Database file path (auto-created on first run)
# NOTE: if you already have data, keep this pointing at the existing .db file
DB_PATH=./data/jagaguru.db

# Secret for the shared-hosting cron endpoint (GET /api/cron/tick?key=THIS)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave EMPTY to disable the endpoint entirely (recommended if you don't need cron).
CRON_SECRET=

# ── AI PROVIDERS ──────────────────────────────────────────────────────────────
# Leave blank to disable a provider. At least ONE must be set.

# Anthropic (Claude Sonnet) — console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o) — platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# OpenRouter — openrouter.ai/keys (FREE: DeepSeek, Qwen, Llama, Gemma, Mistral)
OPENROUTER_API_KEY=sk-or-v1-...

# Groq (ultra-fast free tier) — console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google Gemini — aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=AIza...

# Together AI — api.together.ai/settings/api-keys (free $1 credit)
TOGETHER_API_KEY=...

# DeepSeek — platform.deepseek.com (very cheap)
DEEPSEEK_API_KEY=sk-...

# HuggingFace — huggingface.co/settings/tokens (free)
HUGGINGFACE_API_KEY=hf_...

# Kimi (Moonshot AI) — platform.moonshot.ai — K2/K3 long-context models
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_DEFAULT_MODEL=kimi-k2-0905-preview

# z.ai (GLM) — z.ai/model-api — GLM-4.6+ open-source flagship, embedded natively
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_DEFAULT_MODEL=glm-4.6

# OmniRoute — free open-source, local-first AI gateway (90+ free models).
# The API exists ONLY when the gateway is self-hosted: `npx omniroute` serves
# it at http://localhost:20128/v1. omniroute.online is a marketing site, not
# an API — pointing the BASE_URL there yields 404 DEPLOYMENT_NOT_FOUND.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_DEFAULT_MODEL=auto

# Free cloud AI (recommended default pool; sign-up is free, no card):
#   Groq   — https://console.groq.com/keys           (llama-3.3-70b, very fast)
#   Gemini — https://aistudio.google.com/app/apikey  (gemini-2.0-flash)
GROQ_API_KEY=
GEMINI_API_KEY=

# xKiro — AI token aggregator (90+ models behind one OpenAI-compatible API).
# Free tier: 500K tokens/day on 40+ ':free' models, no card — key at xkiro.com.
# Default model rides the free pool; override with a concrete id if you prefer.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_DEFAULT_MODEL=qwen/qwen3.7-max:free

# Cloudflare Workers AI — free daily neuron allocation, edge inference
dash.cloudflare.com → Workers AI → Use REST API (Account ID + API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct

# ♾️ AUTO-ROTATION — set Default Model to "auto" in Admin → AI Engine.
# Spreads every request across the plan's pool and cools down failures
# automatically. Free plans rotate free pools only; Voyager/Unlimited add
# Kimi/z.ai/DeepSeek-direct/OpenAI/Claude. No env required.

# Ollama (self-hosted AI Engine — MAIN AI, tried before all cloud APIs)
# Install: https://ollama.ai  →  `ollama serve`  →  `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434

# ── SELF-HOSTED AI ENGINE (main AI) ────────────────────────────────────
# JapaQuest runs Llama / Qwen / DeepSeek on YOUR hardware first, and only
# falls back to the cloud APIs above when the engine can't answer.
# Any OpenAI-compatible runtime works. Order of detection:
#   Ollama (11434)  →  vLLM (8000)  →  LM Studio (1234)
# Comma-separated models in priority order (per family):
AI_ENGINE_MODELS=llama3.1,qwen2.5:7b,deepseek-r1:8b
# Cloud fallback when the engine is down ('1' = enabled, recommended)
AI_ENGINE_FALLBACK=1
# Optional extra runtimes (all OpenAI-compatible /v1 APIs)
VLLM_BASE_URL=
LMSTUDIO_BASE_URL=
# Engine API key — only needed if your runtime sits behind an auth proxy
OLLAMA_API_KEY=

# ── TRAVEL AFFILIATE (Impact.com) ─────────────────────────────────────────────
# Sign up at app.impact.com — your affiliate IDs for each travel partner.
# These are used to generate tracked links when the AI recommends bookings.

# Booking.com affiliate (Impact) — the most important one for hotels
BOOKING_COM_AFFILIATE_ID=your_impact_affiliate_id

# Skyscanner flights (Impact or RapidAPI)
SKYSCANNER_AFFILIATE_ID=your_skyscanner_id

# RentalCars.com (Impact) — car rentals
RENTALCARS_AFFILIATE_ID=your_rentalcars_id

# Viator (activities & tours, part of TripAdvisor)
VIATOR_API_KEY=your_viator_key
VIATOR_AFFILIATE_ID=your_viator_affiliate_id

# Hostelworld (budget accommodation)
HOSTELWORLD_AFFILIATE_ID=your_hostelworld_id

# GetYourGuide (tours & activities)
GETYOURGUIDE_PARTNER_ID=your_gyg_partner_id

# ── AMADEUS TRAVEL API (free tier — flights + hotels search) ──────────────────
# Register free at developers.amadeus.com — gives real flight prices
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENV=test
# Change to: AMADEUS_ENV=production when going live

# ── PAYMENTS ──────────────────────────────────────────────────────────────────
# Enable whichever payment providers you want to accept.

# Paystack (best for Nigeria) — dashboard.paystack.com/settings/developers
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# Flutterwave (pan-African) — dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_PROD_...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_PROD_...

# Stripe (international) — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OPay (Nigeria digital wallet) — merchant.opayweb.com
OPAY_MERCHANT_ID=...
OPAY_SECRET_KEY=...
OPAY_PUBLIC_KEY=...

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=JapaQuest
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ── APP SETTINGS ──────────────────────────────────────────────────────────────
APP_NAME=JapaQuest
APP_URL=http://localhost:4001
SUPPORT_EMAIL=support@yourdomain.com

# ── SOCIAL DIRECT POSTING (optional — admin Social Posts tab) ────────────────
# X (Twitter) API v2 — keys from developer.x.com (project app, read+write).
# Enables real auto-posting of scheduled social posts to X.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Telegram Bot API — create a bot with @BotFather, add it to your channel
# as admin, then set the chat id (channel @handle or numeric -100… id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bluesky (AT Protocol) — app password from Bluesky → Settings → App passwords
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
# Discord channel webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# Webhook fallbacks (Zapier/Make/n8n or platform-specific incoming webhooks).
# Used for platforms without a direct integration above.
SOCIAL_TWITTER_WEBHOOK=
SOCIAL_FACEBOOK_WEBHOOK=
SOCIAL_LINKEDIN_WEBHOOK=
SOCIAL_TELEGRAM_WEBHOOK=
SOCIAL_SLACK_WEBHOOK=
# How often the social scheduler scans for due posts (seconds, default 60)
SOCIAL_SCAN_INTERVAL=60

# ── SCHEDULER TESTING ─────────────────────────────────────────────────────────
# Set to 1 to run the Monday weekly digest on ANY day (testing only — never set
# this in production, or users get a digest every scan).
JOURNEY_FORCE_DIGEST=
